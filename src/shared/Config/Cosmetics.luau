--!strict
local function item(
	id: string,
	name: string,
	slot: string,
	color: string,
	accent: string,
	price: number?,
	free: boolean?,
	style: string?
)
	return table.freeze({
		id = id,
		name = name,
		slot = slot,
		color = color,
		accent = accent,
		price = price,
		free = free == true,
		style = style,
		seasonal = style == "santa",
	})
end
