local function item(
	id: string,
	slot: string,
	en: string,
	hu: string,
	color: string,
	accent: string,
	price: number
)
	return table.freeze({
		id = id,
		slot = slot,
		en = en,
		hu = hu,
		color = color,
		accent = accent,
		price = price,
	})
end
